# ============================================================================
# StudyBud Environment Template
# Copy this file to .env and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE (Frontend) - REQUIRED
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------------------------
# GOOGLE OAUTH - REQUIRED for Google Sign-In
# ----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# AI PROVIDERS (Frontend) - REQUIRED for AI features
# ----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_OPENAI_API_KEY=your-openai-api-key

# ----------------------------------------------------------------------------
# PAYMENTS (Frontend) - REQUIRED for Premium subscriptions
# Use TEST keys for development, LIVE keys only in production
# ----------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_id
# VITE_PAYPAL_CLIENT_ID=your-paypal-client-id  # Optional, set in Supabase Edge Functions

# ----------------------------------------------------------------------------
# VIDEO GENERATION - REQUIRED for AI video lessons
# ----------------------------------------------------------------------------
VITE_VIDEO_GEN_URL=http://localhost:3001/api/generate

# ----------------------------------------------------------------------------
# VOICE / TTS / AVATAR SERVICES (Optional - for voice lessons)
# ----------------------------------------------------------------------------
# VAPI (Voice AI)
VITE_VAPI_API_KEY=your-vapi-api-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id
VITE_VAPI_VOICE_ID=elliot

# Murf TTS
VITE_MURF_API_KEY=your-murf-api-key
VITE_MURF_VOICE_ID=zaara
VITE_MURF_TTS_URL=

# HeyGen Talking-Head Videos
VITE_HEYGEN_API_KEY=your-heygen-api-key
VITE_HEYGEN_AVATAR_ID=your-heygen-avatar-id
VITE_HEYGEN_VOICE_ID=your-heygen-voice-id

# ----------------------------------------------------------------------------
# GEMINI STT (Speech-to-Text)
# ----------------------------------------------------------------------------
VITE_GEMINI_STT_MODEL=gemini-1.5-flash

# ----------------------------------------------------------------------------
# MOBILE APP (Expo) - Set in studybud-mobile/.env
# ----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# EXPO_PUBLIC_VIDEO_SERVER_URL=http://localhost:3001/api/generate

# ----------------------------------------------------------------------------
# SERVER-SIDE ONLY (Set in Supabase Edge Function Secrets Dashboard)
# Do NOT put these in frontend .env - they are for backend only
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENAI_API_KEY=your-openai-api-key
# TAVILY_API_KEY=your-tavily-api-key
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# FRONTEND_URL=http://localhost:5173