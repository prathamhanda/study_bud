# StudyBud Mobile App Environment Variables
# Copy to .env and fill in your values

# Supabase (Required)
EXPO_PUBLIC_SUPABASE_URL=https://yjdcshkqgzcubniinwoc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Video Generation Server
# Local: http://localhost:3001/api/generate
# Production: https://your-video-gen-domain.com/api/generate
EXPO_PUBLIC_VIDEO_SERVER_URL=http://localhost:3001/api/generate

# App URL (for deep linking, OAuth redirects)
# Local: exp://localhost:8081
# Production: https://studybud.prathamh.com
EXPO_PUBLIC_APP_URL=http://localhost:8081